# syntax=docker/dockerfile:1

FROM node:24-alpine AS deps

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
	pnpm install --frozen-lockfile

FROM deps AS build

ARG VITE_BACKEND_URL=/api
ARG LOGTO_ENDPOINT
ARG LOGTO_APP_ID
ARG LOGTO_API_RESOURCE

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV LOGTO_ENDPOINT=$LOGTO_ENDPOINT
ENV LOGTO_APP_ID=$LOGTO_APP_ID
ENV LOGTO_API_RESOURCE=$LOGTO_API_RESOURCE

COPY . .
RUN pnpm build

FROM caddy:2.10-alpine AS runtime

RUN apk add --no-cache curl \
	&& addgroup -S caddy \
	&& adduser -S -D -H -h /var/lib/caddy -s /sbin/nologin -G caddy caddy \
	&& mkdir -p /config /data /srv /var/lib/caddy \
	&& chown -R caddy:caddy /config /data /srv /etc/caddy /var/lib/caddy

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build --chown=caddy:caddy /app/dist /srv

USER caddy

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=5 \
	CMD curl -fsS http://127.0.0.1/ >/dev/null || exit 1
