# vite.config.ts sets envDir: '..' and loads env files with loadEnv(mode, '..', ''),
# so these values must live in the REPOSITORY ROOT .env / .env.local, not here.
# They carry no VITE_ prefix: vite.config.ts injects them into the bundle as
# import.meta.env.VITE_LOGTO_* and VITE_BACKEND_URL.

LOGTO_ENDPOINT=http://localhost:3011
LOGTO_APP_ID=your_logto_app_id
LOGTO_API_RESOURCE=https://api.asm2.local

# Optional. Empty falls back to /api in production builds and
# http://localhost:8001 in dev (see src/lib/api.ts).
BACKEND_URL=http://localhost:8001
