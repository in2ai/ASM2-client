# syntax=docker/dockerfile:1

FROM python:3.10-slim AS builder

ARG USE_LOCAL_EMB=false
ARG LOCAL_EMB_REPO=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    SENTENCE_TRANSFORMERS_HOME=/app/models \
    HF_HOME=/app/models \
    STANZA_RESOURCES_DIR=/app/models/stanza \
    NLTK_DATA=/app/models/nltk \
    LANG=es_ES.UTF-8 \
    LANGUAGE=es_ES:es \
    LC_ALL=es_ES.UTF-8 \
    TZ=Europe/Madrid

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    locales \
    && sed -i 's/^# *\(es_ES.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen es_ES.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=secret,id=hf_token,env=HF_TOKEN \
    mkdir -p /app/data /app/models/stanza /app/models/nltk /app/qdrant_index /app/secrets \
    && uv sync --frozen --no-dev \
    && /opt/venv/bin/python -c "import stanza; \
stanza.download('es', package='ancora', processors='tokenize,mwt,pos,lemma'); \
stanza.download('en', processors='tokenize,mwt,pos,lemma'); \
stanza.download('gl', package='ctg', processors='tokenize,mwt,pos,lemma')" \
    && /opt/venv/bin/python -c "import os, nltk; nltk.download('stopwords', download_dir=os.environ['NLTK_DATA'])" \
    && /opt/venv/bin/python -c "from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='cis-lmu/glotlid', filename='model.bin')" \
    && /opt/venv/bin/python -c "from sentence_transformers import CrossEncoder; \
CrossEncoder('cross-encoder/mmarco-mMiniLMv2-L12-H384-v1')"

RUN if [ "$USE_LOCAL_EMB" = "true" ]; then \
      /opt/venv/bin/python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('$LOCAL_EMB_REPO')"; \
    fi

COPY benchmark.py benchmark.py
COPY src src
COPY graph graph

FROM python:3.10-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SENTENCE_TRANSFORMERS_HOME=/app/models \
    HF_HOME=/app/models \
    STANZA_RESOURCES_DIR=/app/models/stanza \
    NLTK_DATA=/app/models/nltk \
    LANG=es_ES.UTF-8 \
    LANGUAGE=es_ES:es \
    LC_ALL=es_ES.UTF-8 \
    TZ=Europe/Madrid \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    locales \
    && sed -i 's/^# *\(es_ES.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen es_ES.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --create-home --home-dir /home/appuser appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=appuser:appuser /app/benchmark.py /app/benchmark.py
COPY --from=builder --chown=appuser:appuser /app/src /app/src
COPY --from=builder --chown=appuser:appuser /app/graph /app/graph
COPY --from=builder --chown=appuser:appuser /app/models /app/models

RUN mkdir -p /app/data /app/qdrant_index /app/secrets && chown -R appuser:appuser /app

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8001/healthz || exit 1

CMD ["python", "benchmark.py"]
