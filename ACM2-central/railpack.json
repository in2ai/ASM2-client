{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "latest"
  },
  "steps": {
    "install": {
      "commands": [
        { "src": "package.json", "dest": "package.json" },
        { "src": "bun.lock", "dest": "bun.lock" },
        {
          "cmd": "bun install",
          "customName": "Install dependencies"
        }
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["...", "bun run build"]
    }
  },
  "deploy": {
    "startCommand": "bun run start"
  }
}