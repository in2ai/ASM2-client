# ============================================
# LOGTO AUTHENTICATION
# ============================================

# Logto self-hosted authentication configuration
# Configure these after setting up Logto via the admin console at http://localhost:3002

# Logto database password (used by logto-db PostgreSQL container)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LOGTO_DB_PASSWORD=your_logto_db_password_here

# Logto Application ID (get from Logto Admin Console > Applications)
# Example: abc123xyz
LOGTO_APP_ID=your_logto_app_id_here

# Logto Application Secret (get from Logto Admin Console > Applications)
# Example: secret_xyz123
LOGTO_APP_SECRET=your_logto_app_secret_here

# Cookie encryption secret (MUST be at least 32 characters)
# This secret is used to encrypt session cookies for security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# IMPORTANT: Use alphanumeric characters only to avoid encoding issues
# SECURITY: Rotate this secret every 90 days in production
# SECURITY: Use different secrets for dev/staging/production
LOGTO_COOKIE_SECRET=your_64_character_alphanumeric_secret_here_1234567890abcdef

# ============================================
# LEGACY WORKOS AUTHENTICATION (DEPRECATED)
# ============================================
# These variables are kept for backward compatibility during migration
# They will be ignored by the new Logto-based authentication

# WorkOS API Key (deprecated - will be removed)
WORKOS_API_KEY=sk_test_your_api_key_here

# WorkOS Client ID (deprecated - will be removed)
WORKOS_CLIENT_ID=client_your_client_id_here

# WorkOS Cookie Password (deprecated - will be removed)
WORKOS_COOKIE_PASSWORD=your_64_character_alphanumeric_secret_password_here_1234567890

# WorkOS Redirect URI (deprecated - will be removed)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Redirect URI for Streamlit application
# Development: http://localhost:8501/
# Production: https://yourdomain.com/
REDIRECT_URI=http://localhost:8501/

# ============================================
# QUESTDB CONFIGURATION  
# ============================================

# QuestDB connection settings
# Choose ONE of the following configurations:
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION A: Local QuestDB (via docker-compose.yml)                │
# │ Use when running the full stack locally with QuestDB container  │
# │ Command: docker compose up                                      │
# └─────────────────────────────────────────────────────────────────┘
# QUESTDB_HOST=questdb
# QUESTDB_PORT=8812
# QUESTDB_USER=admin
# QUESTDB_PASSWORD=quest
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION B: Remote QuestDB on VPS (via docker-compose.remote.yml) │
# │ Use when connecting to QuestDB deployed on a VPS                │
# │ Command: docker compose -f docker-compose.remote.yml up         │
# └─────────────────────────────────────────────────────────────────┘
# QUESTDB_HOST=your-vps-ip-or-hostname
# QUESTDB_PORT=8812
# QUESTDB_USER=admin
# QUESTDB_PASSWORD=your_secure_password
#
# Required VPS firewall ports:
#   - 8812: PostgreSQL wire protocol (required)
#   - 9000: Web console/REST API (optional)
#   - 9009: InfluxDB Line Protocol (if needed)

QUESTDB_HOST=questdb
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DB=qdb

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment (development, test, or production)
NODE_ENV=development

# OPTIONAL: Dashboard port (used by Next.js)
PORT=3001

# Public application URL (used for redirects and OAuth callbacks)
# For local development: http://localhost:3001
# For Dokploy deployments: https://${{DOKPLOY_DEPLOY_URL}}
# This is required for preview deployments to know which subdomain to use
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Timezone for date/time operations
TZ=Europe/Madrid

# Skip environment validation (useful for Docker builds)
# Set to 'true' to skip validation during container builds
SKIP_ENV_VALIDATION=false

# ============================================
# OPENAI CONFIGURATION
# ============================================

# OpenAI API Key for AI/ML features
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# STORAGE CONFIGURATION
# ============================================

# Folder ID for document storage (if applicable)
FOLDER_ID=your_folder_id_here

# ============================================
# TOPIC EXTRACTION CONFIGURATION
# ============================================

# Enable/disable automatic topic extraction from documents
# Set to 'True' to enable topic extraction, 'False' to disable
# When enabled, the system will analyze document chunks to identify and extract topics
CALCULATE_TOPICS=False

# Minimum number of initial chunks required to extract topics
# Topic detection with fewer chunks may not be as accurate
# Default: 20000
TOPIC_MIN_SIZE=20000

# Topic resolution parameter (controls granularity of topic detection)
# Lower values = coarser topics (fewer, broader topics)
# Higher values = finer topics (more, specific topics)
# Default: 0.025
TOPIC_RESOLUTION=0.025

# Minimum representation fraction for topic consideration
# A topic must have at least this fraction of representation in its neighborhood
# to be considered relevant for the document
# Default: 0.3
TOPIC_MIN_CONTRIB=0.3

# ============================================
# DOCKER CONFIGURATION
# ============================================

# User and Group IDs for Docker volume permissions
# Get with: echo "UID=$(id -u) GID=$(id -g)"
UID=1000
GID=1000

# ============================================
# DOCKER COMPOSE FILE SELECTION
# ============================================

# Docker Compose files to load
# This controls which services are started and how they are configured
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION 1: Full Local Stack (default)                            │
# │ Includes: app, questdb, questdb-init, dashboard                 │
# │ Use for: Local development with all services running locally    │
# └─────────────────────────────────────────────────────────────────┘
COMPOSE_FILE=docker-compose.yml
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION 2: Full Local Stack + GPU Support                        │
# │ Includes: app (with GPU), questdb, questdb-init, dashboard      │
# │ Use for: Local development with GPU acceleration                │
# │ Requirements: NVIDIA drivers + nvidia-container-toolkit         │
# └─────────────────────────────────────────────────────────────────┘
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION 3: Remote QuestDB (VPS)                                  │
# │ Includes: app, dashboard (connects to remote QuestDB)           │
# │ Use for: Running services locally while using remote database   │
# └─────────────────────────────────────────────────────────────────┘
# COMPOSE_FILE=docker-compose.remote.yml
#
# To enable GPU support with remote QuestDB, use:
# COMPOSE_FILE=docker-compose.remote.yml:docker-compose.gpu.yml
