# ============================================
# LOGTO AUTHENTICATION
# ============================================

# Logto self-hosted authentication configuration
# Configure these after setting up Logto via the admin console at http://localhost:3002

# Logto SPA application ID (get from Logto Admin Console > Applications)
# Example: abc123xyz
LOGTO_APP_ID=your_logto_app_id_here

# Shared Logto endpoint used by the browser and backend.
# Local self-hosted default: http://localhost:3011
# Remote / cloud example: https://your-tenant.logto.app
# When the backend runs in Docker, localhost is normalized to host.docker.internal automatically.
LOGTO_ENDPOINT=http://localhost:3011

# API resource identifier used for strict JWT audience validation in FastAPI
# Example: https://api.asm2.local
LOGTO_API_RESOURCE=https://api.asm2.local

# Logto admin console endpoint and local self-hosted database password.
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_POSTGRES_PASSWORD=change_me_for_local_logto

# Optional: Machine-to-machine credentials for Logto Management API access
# Create a Logto M2M application with access to the built-in Logto Management API.
# The default management API resource for self-hosted Logto is usually https://default.logto.app/api
LOGTO_MANAGEMENT_APP_ID=your_logto_management_app_id_here
LOGTO_MANAGEMENT_APP_SECRET=your_logto_management_app_secret_here
LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api

# ============================================
# QUESTDB CONFIGURATION  
# ============================================

# QuestDB connection settings
# Choose ONE of the following configurations:
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION A: Local QuestDB (via docker-compose.yml)                │
# │ Use when running the full stack locally with QuestDB container  │
# │ Command: docker compose up                                      │
# └─────────────────────────────────────────────────────────────────┘
# QUESTDB_HOST=questdb
# QUESTDB_PORT=8812
# QUESTDB_USER=admin
# QUESTDB_PASSWORD=change_me_for_local_pgwire
# QUESTDB_HTTP_USER=admin
# QUESTDB_HTTP_PASSWORD=change_me_for_local_http
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ OPTION B: Remote QuestDB on VPS                                 │
# │ Use when connecting to QuestDB deployed on a VPS                │
# │ Command: ./run.sh up --remote                                   │
# └─────────────────────────────────────────────────────────────────┘
# QUESTDB_HOST=your-vps-ip-or-hostname
# QUESTDB_PORT=8812
# QUESTDB_USER=admin
# QUESTDB_PASSWORD=your_secure_password
# QUESTDB_HTTP_USER=your_http_username
# QUESTDB_HTTP_PASSWORD=your_http_password
#
# Required VPS firewall ports:
#   - 8812: PostgreSQL wire protocol (required)
#   - 9000: Web console/REST API (optional)
#   - 9009: InfluxDB Line Protocol (if needed)

QUESTDB_HOST=questdb
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=change_me_for_local_pgwire
QUESTDB_DB=qdb
QUESTDB_HTTP_USER=admin
QUESTDB_HTTP_PASSWORD=change_me_for_local_http

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Allowed CORS origins for FastAPI backend (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ============================================
# OPENAI CONFIGURATION
# ============================================

# OpenAI API Key for AI/ML features
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# HUGGING FACE HUB (BUILD-TIME ONLY)
# ============================================

# Optional read-only Hugging Face token used ONLY during `docker compose build`
# to authenticate model downloads performed in backend/Dockerfile (glotlid,
# cross-encoder, stanza). Authenticated requests bypass the anonymous rate
# limits of the HF Hub and make cold backend builds significantly faster.
#
# - Create a token at: https://huggingface.co/settings/tokens (Read scope is enough)
# - The token is injected as a BuildKit secret (not baked into image layers).
# - At runtime the backend runs with HF_HUB_OFFLINE=1, so this token is never
#   read by the running container.
# - Leave empty or unset if you do not need faster builds; the build will then
#   run unauthenticated and may be rate-limited by HF Hub.
HF_TOKEN=

# ============================================
# STORAGE CONFIGURATION
# ============================================

# Folder ID for document storage (if applicable)
FOLDER_ID=your_folder_id_here

# Optional explicit Google OAuth client secret file path.
# Useful when mounting a file into Docker instead of using CLIENT_SECRET.
# GOOGLE_CLIENT_SECRET_FILE=/app/secrets/client_secret.json

# Google Drive OAuth: same JSON as secrets/client_secret.json (single line).
# Prefer this over mounting secrets/ when deploying without a secrets file.
# Wrap the whole JSON in single quotes so Docker Compose's .env parser does not
# treat inner double quotes as the end of the value (double-quoted JSON breaks).
# CLIENT_SECRET='{"installed":{"client_id":"...","client_secret":"...",...}}'

# ============================================
# TOPIC EXTRACTION CONFIGURATION
# ============================================

# Enable/disable automatic topic extraction from documents
# Set to 'True' to enable topic extraction, 'False' to disable
# When enabled, the system will analyze document chunks to identify and extract topics
CALCULATE_TOPICS=False

# Minimum number of initial chunks required to extract topics
# Topic detection with fewer chunks may not be as accurate
# Default: 20000
TOPIC_MIN_SIZE=20000

# Topic resolution parameter (controls granularity of topic detection)
# Lower values = coarser topics (fewer, broader topics)
# Higher values = finer topics (more, specific topics)
# Default: 0.025
TOPIC_RESOLUTION=0.025

# Minimum representation fraction for topic consideration
# A topic must have at least this fraction of representation in its neighborhood
# to be considered relevant for the document
# Default: 0.3
TOPIC_MIN_CONTRIB=0.3

# ============================================
# DOCKER RUN MODES
# ============================================

# Recommended entrypoint:
#   ./run.sh up                         # backend + SPA + local QuestDB/Logto
#   ./run.sh up --remote               # backend + SPA, using remote QuestDB/Logto
#   ./run.sh up --gpu                  # backend GPU
#   ./run.sh up --qdrant nvidia        # Qdrant NVIDIA GPU
#   ./run.sh up --qdrant amd           # Qdrant AMD GPU
#   ./run.sh up --gpu --qdrant nvidia  # backend GPU + Qdrant GPU
#
# Manual compose equivalents:
#   Local infra:  docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
#   Remote infra: docker compose -f docker-compose.yml up --build

# ============================================
# QDRANT GPU ACCELERATION
# ============================================

# Qdrant supports GPU acceleration for vector indexing.
# The base stack uses CPU-only Qdrant.
# Add the appropriate override file to enable GPU acceleration.
#
# Manual examples:
#   docker compose -f docker-compose.yml -f docker-compose.qdrant-nvidia.yml up
#   docker compose -f docker-compose.yml -f docker-compose.local.yml -f docker-compose.qdrant-amd.yml up
