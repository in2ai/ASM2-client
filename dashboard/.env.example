# ============================================
# WORKOS AUTHENTICATION
# ============================================

# Get these credentials from your WorkOS dashboard: https://dashboard.workos.com/
# Navigate to: API Keys section in your WorkOS application

# WorkOS API Key (starts with 'sk_test_' for test environment or 'sk_live_' for production)
# Example: sk_test_1234567890abcdefghijklmnopqrstuvwxyz
WORKOS_API_KEY=sk_test_your_api_key_here

# WorkOS Client ID (starts with 'client_')
# Example: client_01ABCDEFGHIJKLMNOPQRSTUVWXYZ
WORKOS_CLIENT_ID=client_your_client_id_here

# Cookie encryption password (MUST be at least 32 characters, 64+ recommended)
# This password is used to encrypt session cookies for security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# IMPORTANT: Use alphanumeric characters only to avoid encoding issues
# SECURITY: Rotate this password every 90 days in production
# SECURITY: Use different passwords for dev/staging/production
#
# Example (64-character hex string):
# WORKOS_COOKIE_PASSWORD=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6abcd
WORKOS_COOKIE_PASSWORD=your_64_character_alphanumeric_secret_password_here_1234567890

# ============================================
# WORKOS REDIRECT CONFIGURATION
# ============================================

# This MUST match EXACTLY what is configured in your WorkOS dashboard
# under: Redirects > Redirect URIs
#
# Development: http://localhost:3001/api/auth/callback
# Production: https://yourdomain.com/api/auth/callback
# Staging: https://staging.yourdomain.com/api/auth/callback
#
# IMPORTANT: 
# - Include protocol (http:// or https://)
# - Include port if non-standard
# - No trailing slash
# - Path must be exactly /api/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ============================================
# QUESTDB CONFIGURATION  
# ============================================

# QuestDB connection settings
# Local development: localhost / Docker: questdb
QUESTDB_HOST=questdb
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DB=qdb

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment (development, test, or production)
NODE_ENV=development

# Timezone for date/time operations
TZ=Europe/Madrid

# ============================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================

# Skip environment validation (useful for Docker builds)
# SKIP_ENV_VALIDATION=false